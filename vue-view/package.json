{
  "name": "vue_with_airtable_as_cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "sync:workflow": "node scripts/sync-workflow-status.js",
    "sync:airtable-psql": "node scripts/sync-airtable-psql.js",
    "sync:inspect": "node scripts/sync-airtable-psql.js --inspect",
    "sync:to-psql": "node scripts/sync-airtable-psql.js --to-psql",
    "sync:to-airtable": "node scripts/sync-airtable-psql.js --to-airtable",
    "seed:cases": "node scripts/seed-cases.js"
  },
  "dependencies": {
    "airtable": "^0.12.2",
    "core-js": "^3.50.0",
    "dotenv": "^18.0.7",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "vue": "2.7.16"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.11.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue2-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": ["error", { "ignores": ["Marketplace"] }]
    },
    "overrides": [
      {
        "files": ["src/**/*.js", "src/**/*.vue"],
        "env": {
          "browser": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
