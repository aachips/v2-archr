{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eventResolver.engineConfig.v1",
  "title": "ARCHR Resolver Engine Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "step", "engines"],
  "properties": {
    "schema": {
      "const": "eventResolver.engineConfig.v1"
    },
    "step": {
      "type": "string",
      "enum": ["step0", "step1", "step2", "step3", "stepX", "step4"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseId": { "type": "string" },
        "snapshotExportedAt": { "type": "string", "format": "date-time" }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/engine" }
    }
  },
  "$defs": {
    "engineName": {
      "type": "string",
      "enum": ["Event JSON", "Search", "Update", "Update Log", "Compare", "Merge", "Create"]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "tables"],
      "properties": {
        "engine": { "$ref": "#/$defs/engineName" },
        "engineId": { "type": "string", "pattern": "^rec[A-Za-z0-9]+$" },
        "options": { "type": "object" },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableSetup" }
        }
      }
    },
    "tableSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupId", "table"],
      "properties": {
        "setupId": { "type": "string", "pattern": "^rec[A-Za-z0-9]+$" },
        "label": { "type": "string" },
        "role": { "type": "string" },
        "table": { "$ref": "#/$defs/table" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableId"],
      "properties": {
        "tableId": { "type": "string", "pattern": "^tbl[A-Za-z0-9]+$" },
        "recordId": { "type": "string", "pattern": "^rec[A-Za-z0-9]+$" },
        "recordSource": { "$ref": "#/$defs/sourceContract" },
        "searchFields": { "$ref": "#/$defs/searchFields" },
        "writeFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/writeFieldWrapper" }
        },
        "mergeFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/writeFieldWrapper" }
        },
        "mergeRules": { "type": "array" },
        "options": { "type": "object" }
      }
    },
    "searchFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryField", "deepFields", "primaryInputKeys", "deepInputKeys", "outputPath"],
      "properties": {
        "primaryField": { "$ref": "#/$defs/fieldWrapper" },
        "deepFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldWrapper" }
        },
        "primaryInputKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "deepInputKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputPath": {
          "type": "string",
          "pattern": "^outputs\\.[A-Za-z0-9_.]+$"
        }
      }
    },
    "fieldWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/field" }
      }
    },
    "writeFieldWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/writeField" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "fieldType"],
      "properties": {
        "fieldId": { "type": "string", "pattern": "^fld[A-Za-z0-9]+$" },
        "fieldType": { "type": "string", "minLength": 1 },
        "fieldLabel": { "type": "string" },
        "semanticName": { "type": "string" },
        "mergeable": { "type": "boolean" }
      }
    },
    "writeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "fieldType", "writeMode"],
      "properties": {
        "fieldId": { "type": "string", "pattern": "^fld[A-Za-z0-9]+$" },
        "fieldType": { "type": "string", "minLength": 1 },
        "fieldLabel": { "type": "string" },
        "semanticName": { "type": "string" },
        "mergeable": { "type": "boolean" },
        "writeMode": {
          "type": "string",
          "enum": ["replace", "append", "appendUnique", "clear", "ignoreIfBlank"]
        },
        "writeSource": { "$ref": "#/$defs/sourceContract" },
        "writeValue": true
      },
      "oneOf": [
        { "required": ["writeSource"], "not": { "required": ["writeValue"] } },
        { "required": ["writeValue"], "not": { "required": ["writeSource"] } }
      ]
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "transform": {
          "type": "string",
          "enum": ["identity", "firstRecordId", "uniqueRecordIds", "toRecordIdArray", "ISODate", "JSON.stringify"]
        },
        "required": { "type": "boolean" },
        "defaultJSON": true,
        "onMissing": {
          "type": "string",
          "enum": ["error", "useDefault", "continue", "manualReview", "skip"]
        }
      }
    }
  }
}
