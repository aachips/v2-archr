// My Assignments - Shows volunteer's upcoming assignments

{
  "component_name": "My Assignments",
  "component_id": "cmp_volunteer_assignments",
  "component_type": "list",
  "data_sources": {
    "assignments": "volunteer_assignments where volunteer_id = current_user AND status = 'confirmed' AND date >= today()"
  },
  "list_item_fields": [
    {
      "field": "project_name",
      "label": "Project",
      "type": "text"
    },
    {
      "field": "date",
      "label": "Date",
      "type": "date"
    },
    {
      "field": "time",
      "label": "Time",
      "type": "time"
    },
    {
      "field": "location",
      "label": "Location",
      "type": "text"
    },
    {
      "field": "crew_lead_name",
      "label": "Crew Lead",
      "type": "text"
    }
  ],
  "list_item_actions": [
    {
      "label": "Get Directions",
      "action": "navigate_external",
      "target": "maps://{location}"
    },
    {
      "label": "Cancel",
      "action": "modal",
      "target": "/cancelAssignmentModal"
    }
  ],
  "sort_order": "date ASC",
  "mobile_layout": "cards"
}
