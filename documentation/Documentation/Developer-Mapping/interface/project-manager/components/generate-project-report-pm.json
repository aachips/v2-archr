{
  "feature": "Assign Crew",
  "component_id": "btn_assign_crew",
  "action": "form",
  "target": "/crewAssignment",
  "fields": [
    {"name": "case_id", "type": "hidden"},
    {"name": "crew_lead_id", "type": "select", "data_source": "system_users WHERE role = CREW_LEAD"},
    {"name": "crew_members", "type": "multiselect", "data_source": "system_users WHERE role = CREW_MEMBER"},
    {"name": "expected_start", "type": "date"},
    {"name": "notes", "type": "textarea"}
  ]
},
{
  "feature": "Assign Crew",
  "component_id": "btn_assign_crew",
  "action": "form",
  "target": "/crewAssignment",
  "fields": [
    {"name": "case_id", "type": "hidden"},
    {"name": "crew_lead_id", "type": "select", "data_source": "system_users WHERE role = CREW_LEAD"},
    {"name": "crew_members", "type": "multiselect", "data_source": "system_users WHERE role = CREW_MEMBER"},
    {"name": "expected_start", "type": "date"},
    {"name": "notes", "type": "textarea"}
  ]
},
{
  "feature": "Approve Estimate",
  "component_id": "btn_approve_estimate",
  "action": "form",
  "target": "/estimateApproval",
  "fields": [
    {"name": "assessment_id", "type": "hidden"},
    {"name": "approved_amount", "type": "currency", "source": "property_assessments.total_estimate"},
    {"name": "approval_notes", "type": "textarea"},
    {"name": "requires_change_order", "type": "boolean"}
  ],
  "business_rules": {
    "max_cap": 50000,
    "warning_if_above_cap": true,
    "requires_bursar_approval": true
  }
},
{
  "feature": "Manage Subcontractors",
  "component_id": "btn_manage_subs",
  "action": "navigate",
  "target": "/subcontractorManagement",
  "views": [
    {"name": "Available Subcontractors", "data_source": "subcontractor_profiles WHERE is_approved = true"},
    {"name": "Quote Requests", "data_source": "subcontractor_quotes WHERE status = 'requested'"},
    {"name": "Active Subcontractors", "data_source": "subcontractor_assignments WHERE status = 'active'"}
  ]
},
{
  "feature": "Report",
  "component_id": "btn_report",
  "action": "navigate",
  "target": "/projectReports",
  "report_types": [
    {"name": "Project Status Report", "format": "pdf"},
    {"name": "Budget vs. Actual", "format": "csv"},
    {"name": "Timeline Summary", "format": "pdf"},
    {"name": "Team Performance", "format": "pdf"}
  ]
}